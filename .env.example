# --- Required ---------------------------------------------------------------
# Railway: reference the Postgres plugin, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:password@localhost:5432/itsm
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Public URL used in email links
APP_URL=https://desk.aventratech.org
NODE_ENV=production

# --- Optional ---------------------------------------------------------------
# PGSSLMODE=require            # when connecting to Postgres over the public internet
# DB_POOL_MAX=10
# DB_DRIVER=auto             # auto (pg if installed) | pg | builtin
# SESSION_HOURS=12
# ALLOW_SIGNUP=true            # set false to disable self-service workspace creation
# TRUST_PROXY=true             # read client IP from X-Forwarded-For (Railway/Cloudflare)

# AI triage, draft replies and KB drafting (falls back to built-in rules if unset)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Email notifications via Resend
# RESEND_API_KEY=
# EMAIL_FROM=Aventra Service Desk <support@aventratech.org>

# Major-incident and SLA-breach alerts
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=

# SLA_INTERVAL_SEC=60          # how often the SLA monitor runs
