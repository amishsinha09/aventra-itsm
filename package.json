{
  "name": "aventra-itsm",
  "version": "1.0.0",
  "description": "Aventra ITSM \u2014 incident, request, problem, change, CMDB and knowledge management with self-healing automation",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:builtin": "DB_DRIVER=builtin node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "node test/ui.e2e.mjs",
    "check:integrations": "node scripts/check-integrations.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  }
}
